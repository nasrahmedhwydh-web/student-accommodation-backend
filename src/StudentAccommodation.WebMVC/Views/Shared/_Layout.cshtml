<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سَكَنُ الطلاب</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy-canvas: #0E1E70;
            --sidebar-bg: #ffffff;
            --text-dark: #0f172a;
            --text-gray: #64748b;
            --primary-blue: #2563eb;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--navy-canvas);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            margin: 0;
            overflow-x: hidden;
        }

        /* المحتوى الرئيسي الأيسر */
        .main-container {
            flex-grow: 1;
            padding: 32px 36px;
            overflow-y: auto;
            max-height: 100vh;
            order: 1;
        }

        /* القائمة الجانبية البيضاء اليمنى */
        .sidebar-right {
            width: 250px;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            padding: 28px 16px;
            flex-shrink: 0;
            min-height: 100vh;
            order: 2;
            box-shadow: -4px 0 25px rgba(0,0,0,0.06);
        }

        .brand-header {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 12px;
            padding: 0 8px 32px 8px;
        }

        .brand-icon-poly {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            clip-path: polygon(25% 0%, 100% 0%, 75% 100%, 0% 100%);
            border-radius: 4px;
        }

        .brand-text h1 {
            font-size: 18px;
            font-weight: 900;
            color: #0f172a;
            line-height: 1.1;
        }

        .brand-text span {
            font-size: 10.5px;
            color: #94a3b8;
            font-weight: 700;
        }

        .nav-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-grow: 1;
        }

        .nav-item-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            color: #64748b;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 13px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-item-link:hover {
            background-color: #f8fafc;
            color: #0f172a;
            transform: translateX(-3px);
        }

        .nav-item-link.active {
            background-color: #eff6ff;
            color: #2563eb;
            font-weight: 800;
        }

        .active-dot-bar {
            display: none;
            align-items: center;
            gap: 4px;
        }

        .nav-item-link.active .active-dot-bar {
            display: flex;
        }

        .dot-indicator {
            width: 6px;
            height: 6px;
            background-color: #2563eb;
            border-radius: 50%;
        }

        .bar-indicator {
            width: 3px;
            height: 14px;
            background-color: #2563eb;
            border-radius: 2px;
        }

        .nav-box-icon {
            width: 14px;
            height: 14px;
            border: 1.5px solid #cbd5e1;
            border-radius: 3px;
        }

        .profile-bottom-card {
            margin-top: auto;
            padding: 12px 14px;
            background: #f8fafc;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid #e2e8f0;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }

        .profile-bottom-card:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 6px 15px rgba(0,0,0,0.06);
        }

        .profile-details {
            display: flex;
            flex-direction: column;
            text-align: right;
        }

        .profile-details .p-name {
            font-size: 12.5px;
            font-weight: 800;
            color: #0f172a;
        }

        .profile-details .p-role {
            font-size: 10.5px;
            color: #64748b;
            font-weight: 600;
        }

        .profile-avatar {
            width: 34px;
            height: 34px;
            background: #2563eb;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <!-- المحتوى الرئيسي للموقع -->
    <div class="main-container">
        @RenderBody()
    </div>

    <!-- القائمة الجانبية البيضاء المطابقة للصورة -->
    <aside class="sidebar-right">
        <div class="brand-header">
            <div class="brand-text">
                <h1>سَكَنُ الطلاب</h1>
                <span>نظام التسكين والإدارة</span>
            </div>
            <div class="brand-icon-poly"></div>
        </div>

        <ul class="nav-links">
            <li>
                <a href="/Home" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <span>لوحة المراقبة العامة</span>
                    <div class="active-dot-bar">
                        <span class="dot-indicator"></span>
                        <span class="bar-indicator"></span>
                    </div>
                </a>
            </li>
            <li>
                <a href="/Requests" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "active" : "")">
                    <span>تدقيق واعتماد الطلبات</span>
                    <div class="nav-box-icon"></div>
                </a>
            </li>
            <li>
                <a href="/Allocations" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Allocations" ? "active" : "")">
                    <span>إدارة الأسرة والتسكين</span>
                    <div class="nav-box-icon"></div>
                </a>
            </li>
        </ul>

        <div class="profile-bottom-card">
            <div class="profile-details">
                <span class="p-name">أ. فهد الأحمد</span>
                <span class="p-role">المشرف المالي</span>
            </div>
            <div class="profile-avatar">FA</div>
        </div>
    </aside>
</body>
</html>
